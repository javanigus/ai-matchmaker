# Template for .env.local — copy this file to .env.local and fill in real values.
# .env.local is gitignored; this file (with no real secrets) is committed so the
# required env vars are documented for anyone setting the project up fresh.

# Supabase — Project Settings -> API Keys ("Publishable and secret API keys" tab)
# NEXT_PUBLIC_* vars are exposed to the browser; only put values here that are
# safe for that. The publishable key is designed to be public (RLS is what
# protects data, not secrecy of this key).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — never prefix with NEXT_PUBLIC_. Carries BYPASSRLS, skips every
# policy, so it must only ever be used in server-side code (API routes, server
# actions), never sent to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — top-bar "Connect" button -> Direct connection -> URI. Used by the
# Supabase CLI (`supabase db push`/`supabase link`) from your local machine to
# apply migrations, not by the deployed app at runtime.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# OpenRouter — https://openrouter.ai/keys. Server-only; used by API routes
# making LLM calls, never exposed to the client.
OPENROUTER_API_KEY=
